{
  "name": "vigilon-agent",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vigilon/runtime build",
    "typecheck": "pnpm --filter @vigilon/runtime typecheck",
    "start": "pnpm --filter @vigilon/runtime start",
    "smoke:version": "pnpm --filter @vigilon/runtime smoke:version",
    "phase1:baseline": "pnpm typecheck && pnpm smoke:version",
    "reference:claude-version": "pnpm --filter @vigilon/claude-code smoke:version"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
