{
  "name": "vigilon-agent",
  "version": "0.1.0",
  "description": "Open-source local whiteboard Agent runtime.",
  "license": "MIT",
  "keywords": [
    "agent",
    "coding-agent",
    "runtime",
    "tui",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miyan0Shiho/VigilonAgent.git"
  },
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @vigilon/runtime build && pnpm --filter @vigilon/tui build",
    "typecheck": "pnpm --filter @vigilon/runtime typecheck && pnpm --filter @vigilon/tui typecheck",
    "start": "pnpm --filter @vigilon/runtime start",
    "tui": "pnpm --filter @vigilon/tui start",
    "smoke:version": "pnpm --filter @vigilon/runtime smoke:version",
    "pack:check": "node scripts/release-pack-check.mjs",
    "pack:dry-run": "pnpm pack:check",
    "release:check": "pnpm typecheck && pnpm --filter @vigilon/runtime test && pnpm --filter @vigilon/tui exec vitest run && pnpm build && pnpm smoke:version && pnpm phase2.5:baseline && pnpm pack:check",
    "phase1:baseline": "pnpm typecheck && pnpm --filter @vigilon/runtime test && pnpm smoke:version",
    "phase2:baseline": "pnpm typecheck && pnpm --filter @vigilon/runtime test && pnpm smoke:version",
    "phase2:acceptance": "pnpm --filter @vigilon/runtime exec tsx scripts/phase2-real-acceptance.ts",
    "phase3:baseline": "pnpm typecheck && pnpm --filter @vigilon/runtime test && pnpm smoke:version && pnpm --filter @vigilon/runtime run doctor",
    "phase3:acceptance": "pnpm --filter @vigilon/runtime exec tsx scripts/phase3-acceptance.ts",
    "phase3:selfhost": "pnpm --filter @vigilon/runtime exec tsx scripts/phase3-selfhost.ts",
    "phase23:boundary-probe": "pnpm --filter @vigilon/runtime run phase23:boundary-probe",
    "phase2.5:baseline": "pnpm --filter @vigilon/runtime run phase2.5:baseline",
    "phase2.5:memory-probe": "pnpm --filter @vigilon/runtime run phase2.5:memory-probe",
    "phase2.5:provider-memory-probe": "pnpm --filter @vigilon/runtime run phase2.5:provider-memory-probe",
    "phase2.5:compact-probe": "pnpm --filter @vigilon/runtime run phase2.5:compact-probe",
    "phase2.5:safety-probe": "pnpm --filter @vigilon/runtime run phase2.5:safety-probe",
    "phase2.5:subagent-probe": "pnpm --filter @vigilon/runtime run phase2.5:subagent-probe",
    "phase2.5:cache-probe": "pnpm --filter @vigilon/runtime run phase2.5:cache-probe",
    "phase2.5:provider-cache-probe": "pnpm --filter @vigilon/runtime run phase2.5:provider-cache-probe",
    "phase2.5:governance-probe": "pnpm --filter @vigilon/runtime run phase2.5:governance-probe",
    "phase3.1:acceptance": "pnpm --filter @vigilon/tui exec tsx scripts/phase31-tui-acceptance.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.2.0",
    "vitest": "^4.1.5"
  }
}
